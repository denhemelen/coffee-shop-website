rules_version = '2';

// Правила безпеки для сайту кав'ярні «Зерно».
// Розгортання: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // Власник сайту — завжди адміністратор (лише з підтвердженою поштою).
    // Ту саму пошту вказано в js/firebase-config.js (OWNER_EMAIL).
    function isOwner() {
      return signedIn()
        && request.auth.token.email == 'denys2017vk@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isOwner()
        || (signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function validProduct(d) {
      return d.name is string && d.name.size() > 0 && d.name.size() <= 80
        && d.price is number && d.price >= 0 && d.price <= 100000
        && d.category in ['classic', 'alt', 'sweet']
        && (!('desc' in d) || (d.desc is string && d.desc.size() <= 120))
        && (!('image' in d) || (d.image is string && d.image.size() < 300000))
        && (!('thumb' in d) || (d.thumb is string && d.thumb.size() < 20000));
    }

    // Товари: бачать усі, змінюють адміни
    match /products/{id} {
      allow read: if true;
      allow create, update: if isAdmin() && validProduct(request.resource.data);
      allow delete: if isAdmin();
    }

    // Налаштування сайту: бачать усі, змінюють адміни
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Список адміністраторів
    match /admins/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }

    // Профіль і кошик користувача: лише власник (адміни можуть читати — для пошуку за email)
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'cart', 'updatedAt'])
        && request.resource.data.email == request.auth.token.email
        && (!('cart' in request.resource.data)
            || (request.resource.data.cart is list && request.resource.data.cart.size() <= 60));
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // Замовлення: створює сам користувач, бачить своє; адміни бачать усі й змінюють статус
    match /orders/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'email', 'items', 'total', 'note', 'status', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == 'new'
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 60
        && request.resource.data.total is number
        && request.resource.data.createdAt == request.time
        && (!('note' in request.resource.data)
            || (request.resource.data.note is string && request.resource.data.note.size() <= 300));
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['new', 'preparing', 'ready', 'done', 'cancelled'];
      allow delete: if isAdmin();
    }
  }
}
